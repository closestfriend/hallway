# Copy to .env (or .env.local) to enable the OpenTopography fallback data
# source. Free key: register at https://opentopography.org/ , then
# "My Account" -> "myOpenTopo Authorizations" -> request an API key.
# Without this set, the app falls straight through to the dev fixture when
# no PLY is present at public/assets/scene.ply.
VITE_OPENTOPOGRAPHY_API_KEY=
